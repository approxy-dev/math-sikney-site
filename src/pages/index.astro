---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import RankEmblem from "../components/RankEmblem.astro";

import home from "../assets/screens/home-phone.png";
import ranks from "../assets/screens/ranks-phone.png";
import landscape from "../assets/screens/round-landscape.png";
import stack from "../assets/screens/stack-setup-phone.png";
import stackRound from "../assets/screens/stack-five-phone.png";
import goldenReceipt from "../assets/screens/stack-golden-receipt.png";
import stats from "../assets/screens/stats-phone.png";
import onboarding from "../assets/screens/onboarding-phone.png";
import play from "../assets/screens/play-phone.png";
import profile from "../assets/screens/profile-phone.png";
import feedback from "../assets/screens/learning-feedback-phone.png";

const title = "Math Sikney App — Offline Mental Math Trainer for Android";
const description =
  "The Math Sikney app is a free offline mental math trainer for Android. Hold an expression in your head, then solve it. No account and no internet access.";
const APK = "/downloads/math-sikney.apk";

const ladder = [
  { tier: "Bronze", rp: "0", color: "var(--tier-bronze)", top: false },
  { tier: "Silver", rp: "300", color: "var(--tier-silver)", top: false },
  { tier: "Gold", rp: "660", color: "var(--tier-gold)", top: false },
  { tier: "Platinum", rp: "1110", color: "var(--tier-platinum)", top: false },
  { tier: "Diamond", rp: "1650", color: "var(--tier-diamond)", top: false },
  { tier: "Heroic", rp: "2310", color: "var(--tier-heroic)", top: true },
  { tier: "Master", rp: "3090", color: "var(--tier-master)", top: true },
  { tier: "Grandmaster", rp: "4090", color: "var(--tier-grandmaster)", top: true },
];

const badges = [
  {
    name: "First Steps",
    cat: "GEN",
    req: "Create your profile and finish your first round.",
  },
  {
    name: "Carry Crusher",
    cat: "ADD",
    req: "Correct additions with 3+ carries.",
  },
  {
    name: "Lightning Adder",
    cat: "ADD",
    req: "Correct additions at L3+ in under 3s.",
  },
  {
    name: "Triple Threat",
    cat: "ADD",
    req: "All-correct ADD rounds with stack 3+.",
  },
  {
    name: "Million Mind",
    cat: "ADD",
    req: "Correct additions with a 7+ digit sum.",
  },
  {
    name: "Borrow Breaker",
    cat: "SUB",
    req: "Correct subtractions with 3+ borrows.",
  },
  {
    name: "Table Titan",
    cat: "MUL",
    req: "Distinct L1 facts (2..9 x 2..9) solved.",
  },
  {
    name: "Rapid Fire",
    cat: "MUL",
    req: "Correct L2 multiplications in under 4 s.",
  },
  {
    name: "Zero Remainder",
    cat: "DIV",
    req: "Pass DIV Level Tests 10/10 at L3+.",
  },
  {
    name: "Four-Way Focus",
    cat: "MIX",
    req: "All-correct N=4 rounds in MIXED.",
  },
  {
    name: "On Fire",
    cat: "GEN",
    req: "Best daily streak length.",
  },
  {
    name: "Clean Mind",
    cat: "GEN",
    req: "25 consecutive correct answers in any mode.",
  },
];

const modes = [
  {
    name: "Practice",
    desc: "Choose the level, the number of questions and how long each expression stays. Optional warm-up and peek. XP at half rate.",
    meta: "Endless",
  },
  {
    name: "Level Test",
    desc: "Ten questions, one at a time. Eight correct with at most two timeouts unlocks the next skill level.",
    meta: "10 questions",
  },
  {
    name: "Ranked Match",
    desc: "Tier-scaled timers, stacks, masks and hearts. RP moves on accuracy, speed and matched digits.",
    meta: "6 rounds at Bronze",
  },
  {
    name: "Daily Challenge",
    desc: "The same five rounds for everyone that day. Bonus XP for finishing.",
    meta: "5 rounds · stack 2",
  },
  {
    name: "Fails Review",
    desc: "Up to twenty missed expressions, lowest digit-match first. A miss clears after two consecutive correct answers.",
    meta: "20 stored",
  },
  {
    name: "Stack Challenge",
    desc: "Five or ten rounds, one to five questions, and a choice of how much a mistake costs. Every round ends with a clear receipt.",
    meta: "5 or 10 rounds",
  },
  {
    name: "Learn & Explore",
    desc: "Counting, bonds to five and ten, addition within ten and twenty. Five foundation skills with hints and untimed input.",
    meta: "5 skills",
  },
];

const shots = [
  {
    img: home,
    wide: false,
    title: "Home",
    note: "The counting frame is the daily goal: each bead is a question you held.",
    alt: "Home screen with a citron daily-practice card, twelve of twenty questions filled in a counting frame, and a Bronze I rank card.",
  },
  {
    img: ranks,
    wide: false,
    title: "Competitive ranks",
    note: "Your rank for each operation, the next threshold, your peak, your streak and the full ladder.",
    alt: "Ranks screen showing Division Bronze I, 0 RP, and the ladder from Bronze to Silver.",
  },
  {
    img: landscape,
    wide: true,
    title: "A round in landscape",
    note: "The keypad sits beside the question, so the numbers stay in view.",
    alt: "Landscape round screen with slot A showing 6 + 3, an answer slot reading 99, and a numeric keypad with a citron submit bar.",
  },
  {
    img: stack,
    wide: false,
    title: "Stack setup",
    note: "Questions per round, rounds in the challenge, an optional answer timer and the multiplier.",
    alt: "Stack Challenge setup screen with question and round steppers and a stack multiplier.",
  },
  {
    img: stackRound,
    wide: false,
    title: "Stack Challenge",
    note: "Build the round, pass a question for free, and watch the multiplier climb as the stack holds.",
    alt: "Stack Challenge round with five expressions and a live multiplier.",
  },
  {
    img: goldenReceipt,
    wide: false,
    title: "Score receipt",
    note: "Every round ends with a clear receipt: stack multiplier, perfect bonus and loss cap. Scores never reduce XP or ranked progress.",
    alt: "Stack Challenge score receipt showing a golden-tower round and its score breakdown.",
  },
  {
    img: stats,
    wide: false,
    title: "Performance",
    note: "Accuracy, average answer time, a seven-day trend with empty days marked, and per-operation totals.",
    alt: "Statistics screen with accuracy and average answer time.",
  },
  {
    img: onboarding,
    wide: false,
    title: "First run",
    note: "Name, one of six symbols, a daily goal, and a restore path for an exported backup.",
    alt: "Onboarding form with a name field, six profile symbols, daily goal buttons and a start button.",
  },
  {
    img: play,
    wide: false,
    title: "Mode select",
    note: "Seven ways in: Learn & Explore, Stack Challenge, Practice, Level Test, Ranked Match, Daily Challenge and Fails Review.",
    alt: "Play screen listing the seven Math Sikney modes, including Stack Challenge and Learn & Explore.",
  },
  {
    img: profile,
    wide: false,
    title: "Profile",
    note: "Account level, badges unlocked, profile settings and local backup.",
    alt: "Profile screen with account level, achievements count and backup options.",
  },
  {
    img: feedback,
    wide: false,
    title: "Learning feedback",
    note: "Learn & Explore shows the dots before it asks for a number.",
    alt: "A learning session showing dots for counting and a numeric answer.",
  },
];

const faqs = [
  {
    q: "What is the Math Sikney app?",
    a: "Math Sikney is a free offline Android app for mental arithmetic. It shows an expression for a few seconds, hides it, and asks you to solve it from memory.",
  },
  {
    q: "Is Math Sikney free?",
    a: "Yes. The Android app is free to download and use. There are no ads, no subscriptions and no in-app purchases.",
  },
  {
    q: "Does it work offline?",
    a: "Completely. The app has no internet permission, so it works in airplane mode and never sends anything anywhere.",
  },
  {
    q: "Do I need an account?",
    a: "No. You create one local profile with a name, a symbol and a daily goal. Nothing is uploaded.",
  },
  {
    q: "Which phones can run it?",
    a: "Android 8.0 and newer.",
  },
  {
    q: "How do I install the APK?",
    a: "Tap Download APK, open the file, and allow installs from your browser if Android asks. It is a direct download, not a Play Store listing.",
  },
  {
    q: "What can I practise?",
    a: "Addition, subtraction, multiplication, division and mixed sets, plus Learn & Explore for counting, number bonds and addition within 10 and 20.",
  },
  {
    q: "Is my progress backed up?",
    a: "You can export a backup file and a CSV of every attempt, then restore it on the same or a new phone. There is no cloud sync.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};
---

<Base title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <header class="topbar">
    <a class="brand" href="#intro">
      <Mark />
      <span>Math Sikney</span>
    </a>
    <a class="btn btn-primary" href={APK} download>Download APK</a>
  </header>

  <div class="shell">
    <aside class="rail" aria-label="Sections">
      <a class="rail-mark" href="#intro" aria-label="Math Sikney, back to top">
        <Mark />
      </a>

      <nav>
        <a href="#intro" data-rail="intro"><span class="n">01</span><span class="t">Intro</span></a>
        <a href="#loop" data-rail="loop"><span class="n">02</span><span class="t">Loop</span></a>
        <a href="#demo" data-rail="demo"><span class="n">03</span><span class="t">Round</span></a>
        <a href="#download" data-rail="download"><span class="n">04</span><span class="t">Get</span></a>
        <a href="#modes" data-rail="modes"><span class="n">05</span><span class="t">Modes</span></a>
        <a href="#ranks" data-rail="ranks"><span class="n">06</span><span class="t">Ranks</span></a>
        <a href="#proof" data-rail="proof"><span class="n">07</span><span class="t">Screens</span></a>
        <a href="#privacy" data-rail="privacy"><span class="n">08</span><span class="t">Privacy</span></a>
        <a href="#faq" data-rail="faq"><span class="n">09</span><span class="t">FAQ</span></a>
      </nav>

      <a class="rail-cta" href={APK} download aria-label="Download the Math Sikney APK">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 4v11M7 10l5 5 5-5M5 20h14" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </aside>

    <main id="main">
      <!-- HERO -->
      <section class="hero" id="intro">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="kicker">Free offline Android app</p>
            <h1>Math Sikney</h1>
            <p class="hero-descriptor">the offline mental math app</p>
            <p class="hero-riff mono">Visualize. Hold. Solve.</p>
            <p class="lead">
              The Math Sikney app behaves like a memory test. The expression appears for a few
              seconds, disappears, and you answer from the picture you kept. It runs entirely on your
              phone.
            </p>
            <div class="actions">
              <a class="btn btn-primary" href={APK} download>
                Download APK
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M12 4v11M7 10l5 5 5-5M5 20h14" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </a>
              <a class="btn btn-ghost" href="#demo">Try the demo</a>
            </div>

            <dl class="stats">
              <div class="stat">
                <dt>Operations</dt>
                <dd>5</dd>
              </div>
              <div class="stat">
                <dt>Skill levels</dt>
                <dd>12</dd>
              </div>
              <div class="stat">
                <dt>Rank tiers</dt>
                <dd>8</dd>
              </div>
              <div class="stat">
                <dt>Badges</dt>
                <dd>40</dd>
              </div>
            </dl>
          </div>

          <div class="hero-stage">
            <span class="stage-tag"><b>L1</b> ADD · 12 of 20</span>
            <figure class="device">
              <Picture
                src={home}
                formats={["avif", "webp"]}
                widths={[320, 360]}
                sizes="(max-width: 900px) 320px, 340px"
                alt="Math Sikney home screen: a citron daily-practice card showing 12 of 20 questions in a counting frame, a Bronze I rank card, and the daily challenge below."
                loading="eager"
                fetchpriority="high"
              />
              <figcaption>A real screen from the app.</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <!-- LOOP -->
      <section class="section" id="loop">
        <div class="wrap">
          <div class="section-head">
            <p class="kicker">The loop</p>
            <h2>Four beats. Then the expression is gone.</h2>
            <p class="lead">
              Every mode runs the same sequence. What changes is how long you get, how many
              expressions you hold at once, and what the app takes away as you climb.
            </p>
          </div>

          <div class="loop-grid">
            <article class="stage-card">
              <div class="stage-head">
                <span class="stage-num">01</span>
                <span class="chip">Show</span>
              </div>
              <div>
                <h3>It appears</h3>
                <p>
                  The expression arrives large and clear, and stays just long enough to read. Early
                  levels give you more time.
                </p>
              </div>
              <div class="stage-visual">
                <span class="expr">476 <span class="op">+</span> 83</span>
              </div>
            </article>

            <article class="stage-card">
              <div class="stage-head">
                <span class="stage-num">02</span>
                <span class="chip">Hold</span>
              </div>
              <div>
                <h3>It disappears</h3>
                <p>
                  The screen clears and you answer from the picture you kept. Higher ranks add
                  shorter timers, masks and noise digits.
                </p>
              </div>
              <div class="stage-visual">
                <span class="expr is-behind">476 <span class="op">+</span> 83</span>
                <span class="shutter-still" aria-hidden="true">Hold it…</span>
              </div>
            </article>

            <article class="stage-card">
              <div class="stage-head">
                <span class="stage-num">03</span>
                <span class="chip">Answer</span>
              </div>
              <div>
                <h3>You rebuild it</h3>
                <p>
                  Digit by digit, in a slot per expression. Higher ranks call the slots out of
                  order, so reading order stops helping.
                </p>
              </div>
              <div class="stage-visual">
                <div class="answer-demo">
                  <div class="slot-line"><span>Answer slot A</span><b>559</b></div>
                  <div class="mini-keys" aria-hidden="true">
                    <span>7</span><span>8</span><span>9</span>
                    <span>4</span><span>5</span><span>6</span>
                  </div>
                </div>
              </div>
            </article>

            <article class="stage-card">
              <div class="stage-head">
                <span class="stage-num">04</span>
                <span class="chip">Reveal</span>
              </div>
              <div>
                <h3>It tells you why</h3>
                <p>
                  Correct answer, your answer, the difference, how many digits matched, the error
                  type, and a note for that specific slip.
                </p>
              </div>
              <div class="stage-visual">
                <div class="reveal-demo">
                  <div class="row"><span>Correct</span><span class="is-good">559</span></div>
                  <div class="row"><span>Yours</span><span class="is-bad">565</span></div>
                  <div class="row"><span>Difference</span><span>+6 too high · 2/3 digits</span></div>
                  <p class="coach-line">Hold the carry digit in mind before moving to the next column.</p>
                </div>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- DEMO -->
      <section class="section" id="demo">
        <div class="wrap demo-grid">
          <div class="demo-copy">
            <p class="kicker">The round</p>
            <h2>Five expressions. Then it's your turn.</h2>
            <p class="lead">
              This is addition at Level 3: a three-digit and a two-digit number, at the app's own
              pace. Peek costs that question's XP.
            </p>

            <ul class="demo-notes">
              <li><b>VIEW</b><span>Watch the expression. It clears on its own.</span></li>
              <li><b>INPUT</b><span>Type with the keyboard or the pad. Enter submits, Backspace deletes.</span></li>
              <li><b>PEEK</b><span>Brings the expression back for a moment. In the app, peeking costs that question's XP.</span></li>
              <li><b>HONEST</b><span>The reveal names the mistake from the digits you typed.</span></li>
            </ul>
          </div>

          <div class="demo-panel">
            <div class="panel" id="round">
              <div class="panel-head">
                <span class="live mono" data-round-label>ADD · L3 · STACK 1</span>
                <span class="mono" data-count>00 / 05</span>
                <button class="panel-reset" type="button" data-reset>Reset</button>
              </div>

              <div class="frame-row">
                <div class="frame" aria-hidden="true">
                  <div class="frame-rod" data-rod></div>
                </div>
                <span class="frame-score mono" data-score>0 of 5 held</span>
              </div>

              <div class="panel-stage" data-stage>
                <span class="stage-label mono" data-phase>Ready</span>
                <div class="expr-line" data-expr><span class="op">—</span></div>
                <div class="mask-plane" data-mask aria-hidden="true">Hold it…</div>
              </div>

              <div class="timer" aria-hidden="true"><i data-timer></i></div>

              <p class="panel-hint" data-hint>
                Press start. The expression stays for a few seconds, then the screen clears.
              </p>

              <div class="answer-row" data-answer hidden>
                <label class="visually-hidden" for="demo-answer">Your answer</label>
                <input
                  id="demo-answer"
                  class="answer-input"
                  data-input
                  type="text"
                  inputmode="numeric"
                  autocomplete="off"
                  spellcheck="false"
                  maxlength="7"
                  placeholder="—"
                />
                <button class="peek" type="button" data-peek>
                  Peek<br /><span class="mono">0 XP</span>
                </button>
              </div>

              <div class="keypad" data-keypad hidden>
                <button class="key" type="button" data-key="1">1</button>
                <button class="key" type="button" data-key="2">2</button>
                <button class="key" type="button" data-key="3">3</button>
                <button class="key" type="button" data-key="4">4</button>
                <button class="key" type="button" data-key="5">5</button>
                <button class="key" type="button" data-key="6">6</button>
                <button class="key" type="button" data-key="7">7</button>
                <button class="key" type="button" data-key="8">8</button>
                <button class="key" type="button" data-key="9">9</button>
                <span class="key is-empty" aria-hidden="true"></span>
                <button class="key" type="button" data-key="0">0</button>
                <button class="key" type="button" data-key="back" aria-label="Delete last digit">⌫</button>
                <button class="key-submit" type="button" data-submit>Submit answer</button>
              </div>

              <button class="btn btn-primary start-btn" type="button" data-start>
                Start the round
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </button>

              <div class="reveal" data-reveal hidden>
                <div class="row"><span class="label">Correct</span><span class="value" data-r-correct></span></div>
                <div class="row"><span class="label">Yours</span><span class="value" data-r-yours></span></div>
                <div class="row"><span class="label">Difference</span><span class="value" data-r-diff></span></div>
                <div class="row">
                  <span class="label">Digits</span>
                  <span class="value digit-strip" data-r-digits aria-hidden="true"></span>
                </div>
                <div class="row"><span class="label">Error type</span><span class="value" data-r-type></span></div>
                <p class="coach" data-r-coach></p>
                <button class="btn btn-primary" type="button" data-next>Next expression</button>
              </div>

              <div class="summary" data-summary hidden>
                <p class="big"><span data-s-correct>0</span> / 5</p>
                <p data-s-line>You held four of five.</p>
                <div class="actions">
                  <button class="btn btn-primary" type="button" data-again>Go again</button>
                  <a class="btn btn-ghost" href="#ranks">See the ladder</a>
                </div>
              </div>

              <p class="visually-hidden" role="status" aria-live="polite" data-live></p>
            </div>
          </div>
        </div>
      </section>

      <!-- DOWNLOAD -->
      <section class="section download-band" id="download">
        <div class="wrap download-grid">
          <div class="download-copy">
            <p class="kicker">Get the app</p>
            <h2>Download the Math Sikney app.</h2>
            <p class="lead">
              A free Android app for mental arithmetic. No account, no store intermediary, and it
              never goes online.
            </p>
            <div class="actions">
              <a class="btn btn-primary" href={APK} download>
                Download APK
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M12 4v11M7 10l5 5 5-5M5 20h14" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </a>
              <a class="btn btn-ghost" href="#demo">Try the demo first</a>
            </div>
            <p class="download-meta mono">APK · 2.3 MB · Android 8.0 and newer</p>
          </div>

          <aside class="download-card" aria-label="Download details">
            <div class="download-pack">
              <Mark />
              <div>
                <p class="pack-name">Math Sikney</p>
                <p class="pack-sub">Mental math for Android</p>
              </div>
            </div>
            <dl>
              <div><dt>Price</dt><dd>Free</dd></div>
              <div><dt>Platform</dt><dd>Android 8.0+</dd></div>
              <div><dt>Size</dt><dd>2.3 MB</dd></div>
              <div><dt>Account</dt><dd>Not required</dd></div>
            </dl>
            <p class="download-note">
              Android may ask you to allow installs from your browser. This is a direct APK, not a
              Play Store listing.
            </p>
            <p class="download-contact">
              Built by <a href="https://github.com/approxy-dev">approxy-dev</a><br />
              Questions: <a href="mailto:approxydev@gmail.com">approxydev@gmail.com</a>
            </p>
          </aside>
        </div>
      </section>

      <!-- MODES -->
      <section class="section" id="modes">
        <div class="wrap">
          <div class="section-head">
            <p class="kicker">Modes</p>
            <h2>Seven ways to train.</h2>
            <p class="lead">
              Addition, subtraction, multiplication, division and mixed play each carry their own
              level, rank, stats and badges. Nothing here is shared between them.
            </p>
          </div>

          <div class="modes">
            {
              modes.map((mode) => (
                <div class="mode-row">
                  <h3 class="mode-name">{mode.name}</h3>
                  <p class="mode-desc">{mode.desc}</p>
                  <p class="mode-meta">{mode.meta}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- RANKS -->
      <section class="ranks-band" id="ranks">
        <div class="wrap section">
          <div class="section-head">
            <p class="kicker">Progression</p>
            <h2>Eight tiers. Ten stars. One open end.</h2>
            <p class="lead">
              Ranked matches score accuracy, speed and how many digits you get right. Higher tiers
              take away time, add masks and hearts, and call slots out of order.
            </p>
          </div>

          <div class="ladder" aria-label="Rank ladder with RP thresholds">
            {
              ladder.map((step) => (
                <div class="rung">
