  <script>
    const links = Array.from(document.querySelectorAll("[data-rail]"));
    const ids = links.map((link) => link.dataset.rail ?? "").filter(Boolean);
    const targets = ids
      .map((id) => document.getElementById(id))
      .filter((el) => el !== null);

    const setActive = (id) => {
      for (const link of links) {
        link.classList.toggle("is-active", link.dataset.rail === id);
      }
    };

    if ("IntersectionObserver" in window && targets.length > 0) {
      const visible = new Map();
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            visible.set(entry.target.id, entry.isIntersecting ? entry.intersectionRatio : 0);
          }
          let best = "";
          let bestRatio = 0;
          for (const [id, ratio] of visible) {
            if (ratio > bestRatio) {
              best = id;
              bestRatio = ratio;
            }
          }
          if (best) setActive(best);
        },
        { rootMargin: "-20% 0px -55% 0px", threshold: [0, 0.2, 0.5, 1] },
      );

      for (const target of targets) observer.observe(target);
    }

    // Chrome does not fetch lazy images that sit outside the visible slice of a
    // horizontal scroller, so upgrade the proof strip once it nears the viewport.
    const strip = document.querySelector(".shots");
    if (strip) {
      const loadStrip = () => {
        for (const img of strip.querySelectorAll("img")) {
          if (!img.complete) img.loading = "eager";
        }
        strip.removeEventListener("scroll", loadStrip);
      };

      if ("IntersectionObserver" in window) {
        const stripObserver = new IntersectionObserver(
          (entries) => {
            if (entries.some((entry) => entry.isIntersecting)) {
              loadStrip();
              stripObserver.disconnect();
            }
          },
          { rootMargin: "600px 0px" },
        );
        stripObserver.observe(strip);
      }

      strip.addEventListener("scroll", loadStrip, { passive: true, once: true });

      const wrap = strip.closest(".shots-wrap");
      if (wrap) {
        const syncFade = () => {
          const max = strip.scrollWidth - strip.clientWidth;
          wrap.classList.toggle("is-static", max <= 2);
          wrap.classList.toggle("is-end", strip.scrollLeft >= max - 2);
        };
        syncFade();
        strip.addEventListener("scroll", syncFade, { passive: true });
        window.addEventListener("resize", syncFade);
      }
    }
  </script>
