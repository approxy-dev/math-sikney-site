---
import "../styles/tokens.css";
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const enableAnalytics = import.meta.env.PROD && process.env.VERCEL === "1";

const site = Astro.site ?? new URL("https://math-sikney-site.vercel.app");
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL("/og.png", site);
const appUrl = new URL("/", site);
const apkUrl = new URL("/downloads/math-sikney.apk", site);
const screenshotUrl = new URL("/og-app.png", site);

const organization = {
  "@type": "Organization",
  "@id": new URL("/#organization", site).href,
  name: "Approxy",
  url: "https://github.com/approxy-dev",
  email: "approxydev@gmail.com",
  sameAs: ["https://github.com/approxy-dev"],
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": new URL("/#website", site).href,
      url: appUrl.href,
      name: "Math Sikney",
      description,
      inLanguage: "en",
      publisher: { "@id": organization["@id"] },
    },
    {
      "@type": "SoftwareApplication",
      "@id": new URL("/#app", site).href,
      name: "Math Sikney",
      alternateName: "Mental Math Visualizer",
      url: appUrl.href,
      applicationCategory: "EducationalApplication",
      applicationSubCategory: "Mental arithmetic trainer",
      operatingSystem: "Android 8.0+",
      inLanguage: ["en", "ne"],
      isAccessibleForFree: true,
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
      },
      downloadUrl: apkUrl.href,
      installUrl: apkUrl.href,
      fileSize: "2.3MB",
      screenshot: screenshotUrl.href,
      publisher: { "@id": organization["@id"] },
      sameAs: ["https://github.com/approxy-dev"],
      description:
        "A free offline Android trainer for mental arithmetic. Expressions appear, disappear, and you answer from memory. No account and no internet access.",
      featureList: [
        "Stack Challenge, Learn & Explore, Practice, Level Test, Ranked Match, Daily Challenge and Fails Review",
        "One-to-five-question Practice and five- or ten-round Stack Challenge",
        "Stacks of one to five expressions held in memory",
        "Eight rank tiers from Bronze to Grandmaster",
        "Forty achievements across five operations",
        "English and Nepali, with Latin or Devanagari numerals",
        "Local backup and CSV export",
      ],
    },
    organization,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="author" content="Approxy" />
    <meta name="application-name" content="Math Sikney" />
    <meta name="theme-color" content="#151916" />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Math Sikney" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Math Sikney — Visualize. Hold. Solve. A real app screen beside the title."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="twitter:image:alt"
      content="Math Sikney — Visualize. Hold. Solve. A real app screen beside the title."
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link
      rel="preload"
      href="/fonts/space-grotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <slot name="head" />

    {enableAnalytics && (
      <script is:inline defer src="/_vercel/insights/script.js"></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
