---
interface Props {
  tier: string;
  color: string;
  top?: boolean;
  id?: string;
}

const { tier, color, top = false, id } = Astro.props;
const gid = `emblem-${(id ?? tier).toLowerCase().replace(/[^a-z]/g, "")}`;
---

<svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={gid} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color={color} stop-opacity="0.85"></stop>
      <stop offset="100%" stop-color={color} stop-opacity="0.35"></stop>
    </linearGradient>
  </defs>
  <path
    d="M24 3.8 42.2 12 39.4 32.6 24 44.2 8.6 32.6 5.8 12Z"
    fill={`url(#${gid})`}
    stroke={color}
    stroke-width="2.9"
    stroke-linejoin="round"></path>
  {
    top ? (
      <path d="M24 12.5 32.6 24 24 34.6 15.4 24Z" fill="#F4F4E9" opacity="0.85" />
    ) : (
      <circle cx="24" cy="23" r="5.3" fill="#F4F4E9" opacity="0.8" />
    )
  }
</svg>
